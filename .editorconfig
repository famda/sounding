root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,py,pyi,ps1,psm1,psd1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf
