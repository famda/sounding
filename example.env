# Copy to .env and set the password (passed to PostgreSQL as POSTGRES_PASSWORD).
SOUNDING_DB_PASSWORD=change-me

# Samples: the name the dashboard shows for this host (defaults to the start of its boot id), and a folder
# on the disk that holds Docker's data (mounted at /host/disk; only its capacity is read).
SOUNDING_HOST_DISPLAY_NAME=
SOUNDING_HOST_DISK_MOUNT=/var/lib/sounding/disk

# Samples: a capability to add to their containers, or empty for none. SYS_PTRACE lets the agent read the
# processes that run as another user than its own (their disk I/O, PSS and open files); it only helps
# where the agent runs as root.
SOUNDING_SAMPLES_CAP_ADD=
